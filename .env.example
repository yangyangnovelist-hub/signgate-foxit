# One credential pair covers Foxit PDF Services and eSign.
FOXIT_CLOUD_API_HOST=https://na1.fusion.foxit.com/pdf-services
FOXIT_CLOUD_API_CLIENT_ID=
FOXIT_CLOUD_API_CLIENT_SECRET=
FOXIT_ESIGN_HOST=https://na1.fusion.foxit.com

# Live eSign email dispatch remains mechanically disabled unless this is true.
SIGNGATE_LIVE_SEND_ENABLED=false

# Optional local prompt planner. The deterministic fallback remains available.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

PORT=8787
# Optional isolated state directory, useful for browser verification.
SIGNGATE_RUNTIME_DIR=runtime
