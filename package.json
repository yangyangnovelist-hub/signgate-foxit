{
  "name": "signgate-foxit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prompt-to-signature document agent with exact-artifact approval, powered by Foxit PDF API MCP and eSign.",
  "scripts": {
    "build:client": "esbuild frontend/experience.js --bundle --format=esm --target=es2022 --minify --outfile=public/experience.js",
    "dev": "npm run build:client && tsx watch src/server.ts",
    "start": "npm run build:client && tsx src/server.ts",
    "test": "vitest run",
    "test:e2e": "node test/browser-e2e.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run build:client && npm run typecheck && npm test"
  },
  "dependencies": {
    "@foxitsoftware/foxit-pdf-api-mcp-server": "0.2.3",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@tsparticles/engine": "4.4.0",
    "@tsparticles/slim": "4.4.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "motion": "13.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
